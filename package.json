{
	"name": "omp-hyper-tools",
	"version": "0.5.0",
	"description": "Enhanced Oh My Pi (OMP) extension for Charm Hyper with dashboard, live rate limits, and usage analytics",
	"author": "Samuel Rubio",
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"omp-plugin",
		"omp-extension",
		"pi-package",
		"hyper",
		"charm-hyper"
	],
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"omp": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"scripts": {
		"fmt": "biome format --write .",
		"lint": "biome lint .",
		"check:biome": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "bun test"
	},
	"peerDependencies": {
		"@oh-my-pi/pi-ai": "*",
		"@oh-my-pi/pi-coding-agent": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.16",
		"@earendil-works/pi-ai": "^0.84.1",
		"@earendil-works/pi-coding-agent": "^0.84.1",
		"tsx": "^4.23.13",
		"typebox": "^1.1.38",
		"typescript": "^6.0.3"
	},
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/samuelrubiodev/omp-hyper-tools"
	}
}
